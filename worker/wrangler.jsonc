{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dashpad",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dashpad"
		}
	],
	// The dashboard build (cd ../dashboard && npm run build). The Worker runs first only for the API and /progress.
	"assets": {
		"directory": "../dashboard/dist",
		"run_worker_first": ["/api/*", "/progress"]
	}
	// Secrets (set with `wrangler secret bulk`, never committed):
	//   PROGRESS_WRITE_KEY — used by scripts/progress-publisher.py on the PC
	//   DASHPAD_READ_KEY   — used by the tablet
	// database_id: written by `wrangler deploy` on the first deploy (wrangler >= 4.45 provisions D1),
	// or pasted by hand from the output of `wrangler d1 create dashpad`.
}